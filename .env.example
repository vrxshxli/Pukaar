# Copy to .env (never commit .env). All of these are optional.
# LLM mode: rules (no model), ollama (local, free), groq (hosted, free tier)
LLM_MODE=rules
# Groq free tier: create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Which events the LLM Planner handles: judgment (default), all, off
PLANNER_SCOPE=judgment
PLANNER_MAX_STEPS=6
PLANNER_TIMEOUT=15
# Local Ollama
OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
# Sign-in passwords (set your own before sharing a link)
PUKAAR_OFFICER_PASSWORD=
PUKAAR_VOLUNTEER_PASSWORD=
